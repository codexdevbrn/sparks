// Regras do Realtime Database.
//
// A linguagem nao tem funcoes, por isso a checagem de cargo aparece repetida:
//   membro -> role do proprio usuario e 'member' ou 'admin'
//   admin  -> role do proprio usuario e 'admin'
//
// Permissao CASCATEIA para baixo: concedida num no mais raso, vale para tudo
// abaixo, e regra mais funda so pode conceder, nunca revogar. Por isso a raiz
// nega tudo e cada no libera o que precisa.
{
  "rules": {
    ".read": false,
    ".write": false,

    // ---------------- membros ----------------
    "members": {
      // Membro le a lista inteira; pendente le apenas o proprio no (abaixo).
      ".read": "auth != null && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin')",

      "$uid": {
        ".read": "auth != null && $uid === auth.uid",

        // Admin escreve em qualquer membro. O proprio usuario cria o seu no
        // como 'pending' e depois edita o perfil sem nunca mudar o cargo.
        ".write": "auth != null && (root.child('members/' + auth.uid + '/role').val() === 'admin' || ($uid === auth.uid && ((!data.exists() && newData.child('role').val() === 'pending') || (data.exists() && newData.exists() && newData.child('role').val() === data.child('role').val()))))",

        "uid": { ".validate": "newData.val() === $uid" },
        "role": { ".validate": "newData.val() === 'pending' || newData.val() === 'member' || newData.val() === 'admin'" },
        "nick": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "charClass": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "email": { ".validate": "newData.isString()" },
        "displayName": { ".validate": "newData.isString()" },
        "photoURL": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    // ---------------- catalogo de sets ----------------
    "sets": {
      ".read": "auth != null && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin')",
      ".write": "auth != null && root.child('members/' + auth.uid + '/role').val() === 'admin'",

      "$setId": {
        ".validate": "newData.hasChildren(['name', 'charClass', 'slots']) && newData.child('slots').hasChildren()",

        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "charClass": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "tier": { ".validate": "newData.isString() && newData.val().length <= 30" },
        // So faz sentido em item unico, mas a validacao nao depende disso --
        // e so mais um campo de texto curto, opcional.
        "itemType": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "notes": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "slots": {
          "$slot": { ".validate": "newData.val() === true" }
        },
        "$other": { ".validate": false }
      }
    },

    // ---------------- filas de interesse nas pecas ----------------
    // Varias pessoas podem querer a mesma peca: elas formam uma fila. O que a
    // chave deterministica '<setId>__<slot>__<uid>' garante e que a MESMA
    // pessoa nao entra duas vezes na mesma fila, porque criar so passa em no
    // inexistente.
    //
    // A ordem da fila vive no campo 'order' e so o admin pode alterar: se o
    // membro pudesse escrever em no existente, ele se colocaria em primeiro.
    "reservations": {
      ".read": "auth != null && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin')",

      "$resId": {
        ".write": "(auth != null && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin') && !data.exists() && newData.exists() && newData.child('uid').val() === auth.uid) || (auth != null && data.exists() && !newData.exists() && (root.child('members/' + auth.uid + '/role').val() === 'admin' || data.child('uid').val() === auth.uid)) || (auth != null && root.child('members/' + auth.uid + '/role').val() === 'admin' && data.exists() && newData.exists())",

        // A chave amarra o registro a uma peca e a uma pessoa, e a peca tem de
        // existir no set. Sem isso daria para gravar em caminho arbitrario e
        // furar tanto a identidade quanto a fila.
        ".validate": "newData.hasChildren(['setId', 'slot', 'uid', 'nick', 'order']) && $resId === newData.child('setId').val() + '__' + newData.child('slot').val() + '__' + newData.child('uid').val() && root.child('sets/' + newData.child('setId').val() + '/slots/' + newData.child('slot').val()).val() === true",

        "setId": { ".validate": "newData.isString()" },
        "setName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "charClass": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "slot": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "uid": { ".validate": "newData.isString()" },
        "nick": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "order": { ".validate": "newData.isNumber()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    // ---------------- historico de entregas ----------------
    // Log append-only: admin registra e pode apagar um registro errado, mas
    // ninguem edita. Log que se edita nao serve de log.
    // Toda a guild le -- a transparencia e o proposito.
    "drops": {
      ".read": "auth != null && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin')",

      "$dropId": {
        ".write": "auth != null && root.child('members/' + auth.uid + '/role').val() === 'admin' && (!data.exists() || !newData.exists())",
        ".validate": "newData.hasChildren(['setId', 'setName', 'slot', 'uid', 'nick', 'byUid', 'at'])",

        "setId": { ".validate": "newData.isString()" },
        "setName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "charClass": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "slot": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "uid": { ".validate": "newData.isString()" },
        "nick": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "byUid": { ".validate": "newData.val() === auth.uid" },
        "byNick": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "at": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    // ---------------- anuncios ----------------
    "announcements": {
      ".read": "auth != null && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin')",
      ".write": "auth != null && root.child('members/' + auth.uid + '/role').val() === 'admin'",

      "$id": {
        ".validate": "newData.hasChildren(['title', 'body'])",

        "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "body": { ".validate": "newData.isString() && newData.val().length <= 4000" },
        // Link externo de imagem. So https, para nao servir javascript: nem data:.
        "imageUrl": { ".validate": "newData.isString() && (newData.val() === '' || (newData.val().length <= 500 && newData.val().matches(/^https:\\/\\/.*/)))" },
        "pinned": { ".validate": "newData.isBoolean()" },
        "authorUid": { ".validate": "newData.isString()" },
        "authorName": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    // ---------------- eventos ----------------
    "events": {
      ".read": "auth != null && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin')",
      ".write": "auth != null && root.child('members/' + auth.uid + '/role').val() === 'admin'",

      "$id": {
        // Tres formas de dizer quando: uma data (`startsAt`), varias (`dates`)
        // ou recorrencia semanal. Precisa de exatamente uma delas -- sem
        // nenhuma, o evento nao teria quando acontecer.
        ".validate": "newData.hasChild('title') && (newData.hasChild('startsAt') || newData.hasChild('dates') || newData.hasChild('recurrence'))",

        "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "type": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "startsAt": { ".validate": "newData.isNumber()" },
        // Varias datas no mesmo evento. Mapa chave -> ms desde a epoca; a
        // chave e gerada pelo cliente e so precisa ser estavel, porque e ela
        // que identifica a lista de presenca daquela data em rsvpCycles.
        "dates": {
          ".validate": "newData.hasChildren()",
          "$dateId": { ".validate": "newData.isNumber() && newData.val() > 0" }
        },
        "recurrence": {
          ".validate": "newData.hasChildren(['weekday', 'hour', 'minute'])",
          "weekday": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6" },
          "hour": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 23" },
          "minute": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 59" },
          "$other": { ".validate": false }
        },
        // Evento fixado aparece no topo da agenda, acima dos demais.
        "pinned": { ".validate": "newData.isBoolean()" },
        // Ausente conta como true -- eventos criados antes desse campo existir
        // ja tinham confirmacao de presenca.
        "rsvpEnabled": { ".validate": "newData.isBoolean()" },
        "createdBy": { ".validate": "newData.isString()" },
        "createdByName": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    // ---------------- presenca em eventos (data fixa) ----------------
    // Fora do no de eventos, para a lista de eventos nao arrastar todas as
    // presencas em cada leitura.
    "rsvps": {
      ".read": "auth != null && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin')",

      "$eventId": {
        // Admin apaga o no inteiro junto com o evento.
        ".write": "auth != null && root.child('members/' + auth.uid + '/role').val() === 'admin' && !newData.exists()",

        "$uid": {
          // Cada membro controla apenas a propria presenca.
          ".write": "auth != null && $uid === auth.uid && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin')",
          ".validate": "newData.hasChildren(['status', 'nick'])",

          "uid": { ".validate": "newData.val() === $uid" },
          "nick": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "status": { ".validate": "newData.val() === 'going' || newData.val() === 'maybe' || newData.val() === 'out'" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    // ---------------- catalogo de bosses ----------------
    "bosses": {
      ".read": "auth != null && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin')",
      ".write": "auth != null && root.child('members/' + auth.uid + '/role').val() === 'admin'",

      "$id": {
        // So o nome e obrigatorio -- muito boss de MU nao tem horario
        // publicado, so local, e forcar um horario inventado seria pior que
        // nao ter contador nenhum.
        ".validate": "newData.hasChild('name')",

        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "location": {
          ".validate": "newData.hasChildren(['map', 'x', 'y'])",
          "map": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "x": { ".validate": "newData.isNumber()" },
          "y": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "notes": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "scheduleNote": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "schedules": {
          "$i": {
            ".validate": "newData.hasChildren(['hour', 'minute'])",
            "weekday": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6" },
            "hour": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 23" },
            "minute": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 59" },
            "$other": { ".validate": false }
          }
        },
        "createdBy": { ".validate": "newData.isString()" },
        "createdByName": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    // ---------------- regras da guild ----------------
    // Um no so, sem lista -- e um texto que o admin mantem, nao um cadastro.
    "guildRules": {
      ".read": "auth != null && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin')",
      ".write": "auth != null && root.child('members/' + auth.uid + '/role').val() === 'admin'",
      ".validate": "newData.hasChild('body')",

      "body": { ".validate": "newData.isString() && newData.val().length <= 8000" },
      "updatedBy": { ".validate": "newData.isString() && newData.val().length <= 20" },
      "updatedAt": { ".validate": "newData.isNumber()" },
      "$other": { ".validate": false }
    },

    // ---------------- enquetes ----------------
    "polls": {
      ".read": "auth != null && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin')",
      ".write": "auth != null && root.child('members/' + auth.uid + '/role').val() === 'admin'",

      "$id": {
        ".validate": "newData.hasChildren(['question', 'options']) && newData.child('options').hasChildren()",

        "question": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "options": {
          "$i": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" }
        },
        "closesAt": { ".validate": "newData.isNumber()" },
        "createdBy": { ".validate": "newData.isString()" },
        "createdByName": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    // Fora do no da enquete, mesmo motivo de sempre: ler a lista de enquetes
    // nao deve arrastar todo mundo que ja votou em cada uma.
    "pollVotes": {
      ".read": "auth != null && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin')",

      "$pollId": {
        // Admin apaga o no inteiro junto com a enquete.
        ".write": "auth != null && root.child('members/' + auth.uid + '/role').val() === 'admin' && !newData.exists()",

        "$uid": {
          // Cada um so registra o proprio voto, e nao pode trocar depois --
          // "!data.exists()" e o que torna o voto definitivo.
          ".write": "auth != null && $uid === auth.uid && !data.exists() && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin')",
          ".validate": "newData.hasChildren(['uid', 'nick', 'optionIndex']) && newData.child('optionIndex').val() >= 0 && root.child('polls/' + $pollId + '/options/' + newData.child('optionIndex').val()).exists()",

          "uid": { ".validate": "newData.val() === $uid" },
          "nick": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "optionIndex": { ".validate": "newData.isNumber()" },
          "votedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    // ---------------- mural de recados ----------------
    // Mensagem curta e informal, ao contrario de 'announcements' (so admin,
    // mais formal). Qualquer membro posta; cada um apaga so a propria, admin
    // apaga qualquer uma.
    "shouts": {
      ".read": "auth != null && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin')",

      "$id": {
        ".write": "(auth != null && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin') && !data.exists() && newData.child('uid').val() === auth.uid) || (auth != null && data.exists() && !newData.exists() && (root.child('members/' + auth.uid + '/role').val() === 'admin' || data.child('uid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['uid', 'nick', 'text'])",

        "uid": { ".validate": "newData.val() === auth.uid" },
        "nick": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 280" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    // ---------------- status no MuEliteWars ----------------
    // Escrito por um scraper externo (GitHub Actions, ver
    // scripts/scrape-mu.mjs) com credencial de servico do Firebase Admin, que
    // ignora as regras. Nenhum cliente escreve aqui -- so le.
    "muStatus": {
      ".read": "auth != null && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin')",
      ".write": false
    },

    // ---------------- presenca em eventos recorrentes ----------------
    // Mesma coisa que 'rsvps', com uma camada a mais: o ciclo semanal. A
    // chave do ciclo muda sozinha 1h antes de cada ocorrencia (ver
    // src/lib/recurrence.ts), e isso e o que "reseta" a lista -- nao existe
    // Cloud Functions no projeto para rodar um cron as 16h de domingo.
    "rsvpCycles": {
      ".read": "auth != null && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin')",

      "$eventId": {
        // Admin apaga o no inteiro junto com o evento.
        ".write": "auth != null && root.child('members/' + auth.uid + '/role').val() === 'admin' && !newData.exists()",

        "$cycleId": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && (root.child('members/' + auth.uid + '/role').val() === 'member' || root.child('members/' + auth.uid + '/role').val() === 'admin')",
            ".validate": "newData.hasChildren(['status', 'nick'])",

            "uid": { ".validate": "newData.val() === $uid" },
            "nick": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "status": { ".validate": "newData.val() === 'going' || newData.val() === 'maybe' || newData.val() === 'out'" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
