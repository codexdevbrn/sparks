# Copie para .env.local e preencha com os dados do seu projeto Firebase
# (Console Firebase > Configuracoes do projeto > Seus apps > Configuracao do SDK)
#
# Estas chaves sao publicas por natureza (vao no bundle do navegador).
# A seguranca dos dados vem das regras em database.rules.json, nao daqui.

# Obrigatorias
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Opcionais (o app nao usa Storage nem Messaging)
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Nome exibido no cabecalho do site
VITE_GUILD_NAME=Sparks

# Opcional: webhook do Discord (Configuracoes do canal > Integracoes >
# Webhooks > Novo Webhook > Copiar URL). Avisa no canal quando sai anuncio,
# evento novo ou entrega registrada. Sem isso, o site funciona igual, so nao
# avisa. Cuidado: essa URL fica publica no bundle do site (ver src/lib/discord.ts).
VITE_DISCORD_WEBHOOK_URL=

# Opcional: link de convite do servidor do Discord (botao no cabecalho).
# Diferente do webhook acima, este e feito pra ser publico -- e um convite.
VITE_DISCORD_INVITE_URL=
