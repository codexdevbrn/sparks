# Copie para .env.local e preencha com os dados do seu projeto Firebase
# (Console Firebase > Configuracoes do projeto > Seus apps > Configuracao do SDK)
#
# Estas chaves sao publicas por natureza (vao no bundle do navegador).
# A seguranca dos dados vem das regras em database.rules.json, nao daqui.

# Obrigatorias
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Opcionais (o app nao usa Storage nem Messaging)
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Nome exibido no cabecalho do site
VITE_GUILD_NAME=Sparks

# Opcional: link de convite do servidor do Discord (botao no cabecalho).
# Esta e feita pra ser publica -- e um convite.
VITE_DISCORD_INVITE_URL=

# Opcional, SEM prefixo VITE_ de proposito: webhook do Discord (Config. do
# canal > Integracoes > Webhooks > Novo Webhook > Copiar URL). Avisa no canal
# quando sai anuncio, evento novo ou entrega registrada. So funciona hospedado
# na Vercel (usa api/discord.ts, uma Edge Function) -- no Firebase Hosting,
# que so serve arquivo estatico, essa rota nao existe e o aviso falha em
# silencio. Configure como env var do PROJETO na Vercel, nao aqui: colocar
# aqui so ajudaria "vercel dev" local, e o nome sem VITE_ e o que garante que
# ela nunca vai parar no bundle do navegador.
# DISCORD_WEBHOOK_URL=
